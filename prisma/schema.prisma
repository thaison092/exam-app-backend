
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id             Int      @id @default(autoincrement())
  text           String
  options        String[]
  correctAnswers String[]
}

model ExamResult {
  id          Int      @id @default(autoincrement())
  studentName String
  score       Int
  answers     Json
  dateTaken   DateTime @default(now())
}
